<mxfile host="app.diagrams.net" agent="Campus Wall" version="22.1.16" type="device">
  <diagram id="login-register-fishbone" name="注册与登录鱼骨流程">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1660" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c3" value="龙华区观澜中学校园墙 · 注册与登录鱼骨流程图" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=28;fontStyle=1;fontColor=#152033;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1600" height="40" as="geometry"/></mxCell>
        <mxCell id="c4" value="主脊从左到右是同学进入校园墙的总路径；上方三根骨是飞书与绑定，下方三根骨是用户名注册、审核与密码登录。可在 diagrams.net 或 VS Code Draw.io 插件中打开编辑。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#5b6678;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1700" height="28" as="geometry"/></mxCell>
        <mxCell id="c5" value="飞书路径（推荐，免审）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;fontStyle=1;strokeWidth=1;arcSize=40;fillColor=#e8eefc;strokeColor=#1d4ed8;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="220" height="32" as="geometry"/></mxCell>
        <mxCell id="c6" value="用户名注册 / 审核" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;fontStyle=1;strokeWidth=1;arcSize=40;fillColor=#f8ead2;strokeColor=#a16207;fontColor=#a16207;" vertex="1" parent="1"><mxGeometry x="280" y="96" width="220" height="32" as="geometry"/></mxCell>
        <mxCell id="c7" value="成功进入" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;fontStyle=1;strokeWidth=1;arcSize=40;fillColor=#d9f0e7;strokeColor=#0f6b52;fontColor=#0f6b52;" vertex="1" parent="1"><mxGeometry x="520" y="96" width="220" height="32" as="geometry"/></mxCell>
        <mxCell id="c8" value="失败 / 拒绝 / 例外" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;fontStyle=1;strokeWidth=1;arcSize=40;fillColor=#fde8e8;strokeColor=#b4232c;fontColor=#b4232c;" vertex="1" parent="1"><mxGeometry x="720" y="96" width="220" height="32" as="geometry"/></mxCell>
        <mxCell id="c9" value="边界与对照（学生勿走）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;fontStyle=1;strokeWidth=1;arcSize=40;fillColor=#e8edf3;strokeColor=#475569;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="960" y="96" width="220" height="32" as="geometry"/></mxCell>
        <mxCell id="c10" value="" style="endArrow=block;endFill=1;endSize=14;html=1;strokeWidth=14;strokeColor=#1e3a5f;fillColor=#1e3a5f;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180" y="790" as="sourcePoint"/><mxPoint x="1920" y="790" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c11" value="起点&lt;br&gt;打开 /login" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;fontStyle=1;fontColor=#ffffff;fillColor=#1e3a5f;strokeColor=none;arcSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="754" width="130" height="72" as="geometry"/></mxCell>
        <mxCell id="c12" value="结果&lt;br&gt;已登录普通用户&lt;br&gt;可发帖 / 填失物招领&lt;br&gt;可进「我的」" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=16;fontStyle=1;fontColor=#ffffff;fillColor=#0f6b52;strokeColor=none;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1940" y="710" width="220" height="160" as="geometry"/></mxCell>
        <mxCell id="c13" value="① 选入口" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=11;fontStyle=1;fillColor=#1e3a5f;fontColor=#ffffff;strokeColor=none;arcSize=40;" vertex="1" parent="1"><mxGeometry x="252" y="776" width="96" height="28" as="geometry"/></mxCell>
        <mxCell id="c14" value="② 校验身份" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=11;fontStyle=1;fillColor=#1e3a5f;fontColor=#ffffff;strokeColor=none;arcSize=40;" vertex="1" parent="1"><mxGeometry x="652" y="776" width="96" height="28" as="geometry"/></mxCell>
        <mxCell id="c15" value="③ 账号状态" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=11;fontStyle=1;fillColor=#1e3a5f;fontColor=#ffffff;strokeColor=none;arcSize=40;" vertex="1" parent="1"><mxGeometry x="1052" y="776" width="96" height="28" as="geometry"/></mxCell>
        <mxCell id="c16" value="④ 签发会话" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=11;fontStyle=1;fillColor=#1e3a5f;fontColor=#ffffff;strokeColor=none;arcSize=40;" vertex="1" parent="1"><mxGeometry x="1452" y="776" width="96" height="28" as="geometry"/></mxCell>
        <mxCell id="c17" value="" style="endArrow=none;html=1;strokeWidth=4;strokeColor=#1e3a5f;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="774" as="sourcePoint"/><mxPoint x="336" y="188" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c18" value="飞书立即进入（推荐）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;fontStyle=1;fontColor=#ffffff;strokeColor=none;arcSize=12;fillColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="180.0" y="148" width="360" height="40" as="geometry"/></mxCell>
        <mxCell id="c19" value="&lt;b&gt;1 先确认已在学生飞书群&lt;/b&gt;&lt;br&gt;群名目前是「观澜中学校园墙」。&lt;br&gt;只认指定内部群，不认群改名，也不认审核群。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;spacingLeft=10;spacingRight=8;spacingTop=4;spacingBottom=4;strokeWidth=1.5;arcSize=8;fillColor=#e8eefc;strokeColor=#1d4ed8;fontColor=#152033;" vertex="1" parent="1"><mxGeometry x="180.0" y="200" width="360" height="72" as="geometry"/></mxCell>
        <mxCell id="c20" value="" style="endArrow=none;html=1;strokeWidth=1.6;strokeColor=#8aa0b8;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="236.0" as="sourcePoint"/><mxPoint x="342" y="236.0" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c21" value="&lt;b&gt;2 点「使用飞书登录」&lt;/b&gt;&lt;br&gt;电脑弹出飞书授权页后扫码；&lt;br&gt;手机一般会跳转飞书 App。不要先填用户名。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;spacingLeft=10;spacingRight=8;spacingTop=4;spacingBottom=4;strokeWidth=1.5;arcSize=8;fillColor=#e8eefc;strokeColor=#1d4ed8;fontColor=#152033;" vertex="1" parent="1"><mxGeometry x="180.0" y="282" width="360" height="72" as="geometry"/></mxCell>
        <mxCell id="c22" value="" style="endArrow=none;html=1;strokeWidth=1.6;strokeColor=#8aa0b8;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="318.0" as="sourcePoint"/><mxPoint x="342" y="318.0" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c23" value="&lt;b&gt;3 系统核对群成员&lt;/b&gt;&lt;br&gt;登录应用机器人必须仍在该群，&lt;br&gt;且该飞书号也在群内。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;spacingLeft=10;spacingRight=8;spacingTop=4;spacingBottom=4;strokeWidth=1.5;arcSize=8;fillColor=#e8eefc;strokeColor=#1d4ed8;fontColor=#152033;" vertex="1" parent="1"><mxGeometry x="180.0" y="364" width="360" height="72" as="geometry"/></mxCell>
        <mxCell id="c24" value="" style="endArrow=none;html=1;strokeWidth=1.6;strokeColor=#8aa0b8;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="400.0" as="sourcePoint"/><mxPoint x="342" y="400.0" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c25" value="&lt;b&gt;4 立即成为普通用户并登录&lt;/b&gt;&lt;br&gt;不经过人工审核，当场发登录会话。&lt;br&gt;飞书登录不会变成管理员。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;spacingLeft=10;spacingRight=8;spacingTop=4;spacingBottom=4;strokeWidth=1.5;arcSize=8;fillColor=#d9f0e7;strokeColor=#0f6b52;fontColor=#134e3a;" vertex="1" parent="1"><mxGeometry x="180.0" y="446" width="360" height="72" as="geometry"/></mxCell>
        <mxCell id="c26" value="" style="endArrow=none;html=1;strokeWidth=1.6;strokeColor=#8aa0b8;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="482.0" as="sourcePoint"/><mxPoint x="342" y="482.0" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c27" value="&lt;b&gt;走不通时&lt;/b&gt;&lt;br&gt;不在指定群 / 点了拒绝 / 登录过期请重来；&lt;br&gt;账号停用；飞书暂未配置。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;spacingLeft=10;spacingRight=8;spacingTop=4;spacingBottom=4;strokeWidth=1.5;arcSize=8;fillColor=#fde8e8;strokeColor=#b4232c;fontColor=#7f1d1d;" vertex="1" parent="1"><mxGeometry x="180.0" y="528" width="360" height="72" as="geometry"/></mxCell>
        <mxCell id="c28" value="" style="endArrow=none;html=1;strokeWidth=1.6;strokeColor=#8aa0b8;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="564.0" as="sourcePoint"/><mxPoint x="342" y="564.0" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c29" value="" style="endArrow=none;html=1;strokeWidth=4;strokeColor=#1e3a5f;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="806" as="sourcePoint"/><mxPoint x="336" y="1460" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c30" value="用户名密码注册" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;fontStyle=1;fontColor=#ffffff;strokeColor=none;arcSize=12;fillColor=#a16207;" vertex="1" parent="1"><mxGeometry x="180.0" y="1460" width="360" height="40" as="geometry"/></mxCell>
        <mxCell id="c31" value="&lt;b&gt;1 登录页切到「注册」&lt;/b&gt;&lt;br&gt;设用户名（2–24 字，中文/字母/数字/._-）&lt;br&gt;和至少 8 位密码，两次输入须一致。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;spacingLeft=10;spacingRight=8;spacingTop=4;spacingBottom=4;strokeWidth=1.5;arcSize=8;fillColor=#f8ead2;strokeColor=#a16207;fontColor=#152033;" vertex="1" parent="1"><mxGeometry x="180.0" y="1048" width="360" height="72" as="geometry"/></mxCell>
        <mxCell id="c32" value="" style="endArrow=none;html=1;strokeWidth=1.6;strokeColor=#8aa0b8;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="1084.0" as="sourcePoint"/><mxPoint x="342" y="1084.0" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c33" value="&lt;b&gt;2 邮箱可以先空着&lt;/b&gt;&lt;br&gt;选填。勾选「验证邮箱后接收消息通知」&lt;br&gt;只在验证成功后才会发通知。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;spacingLeft=10;spacingRight=8;spacingTop=4;spacingBottom=4;strokeWidth=1.5;arcSize=8;fillColor=#f8ead2;strokeColor=#a16207;fontColor=#152033;" vertex="1" parent="1"><mxGeometry x="180.0" y="1130" width="360" height="72" as="geometry"/></mxCell>
        <mxCell id="c34" value="" style="endArrow=none;html=1;strokeWidth=1.6;strokeColor=#8aa0b8;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="1166.0" as="sourcePoint"/><mxPoint x="342" y="1166.0" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c35" value="&lt;b&gt;3 点「提交注册审核」&lt;/b&gt;&lt;br&gt;只创建待审普通账号，当场不发登录 Cookie。&lt;br&gt;成功后页面会提示等待审核。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;spacingLeft=10;spacingRight=8;spacingTop=4;spacingBottom=4;strokeWidth=1.5;arcSize=8;fillColor=#f8ead2;strokeColor=#a16207;fontColor=#152033;" vertex="1" parent="1"><mxGeometry x="180.0" y="1212" width="360" height="72" as="geometry"/></mxCell>
        <mxCell id="c36" value="" style="endArrow=none;html=1;strokeWidth=1.6;strokeColor=#8aa0b8;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="1248.0" as="sourcePoint"/><mxPoint x="342" y="1248.0" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c37" value="&lt;b&gt;发信失败不影响注册&lt;/b&gt;&lt;br&gt;若填了邮箱，系统会尝试发 24 小时验证链接。&lt;br&gt;信没发出去，注册本身仍算提交成功。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;spacingLeft=10;spacingRight=8;spacingTop=4;spacingBottom=4;strokeWidth=1.5;arcSize=8;fillColor=#f4f6f9;strokeColor=#94a3b8;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="180.0" y="1294" width="360" height="72" as="geometry"/></mxCell>
        <mxCell id="c38" value="" style="endArrow=none;html=1;strokeWidth=1.6;strokeColor=#8aa0b8;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="1330.0" as="sourcePoint"/><mxPoint x="342" y="1330.0" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c39" value="&lt;b&gt;提交失败常见原因&lt;/b&gt;&lt;br&gt;用户名不合规、密码太短、两次密码不一致；&lt;br&gt;用户名已被占用（含飞书保留名）。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;spacingLeft=10;spacingRight=8;spacingTop=4;spacingBottom=4;strokeWidth=1.5;arcSize=8;fillColor=#fde8e8;strokeColor=#b4232c;fontColor=#7f1d1d;" vertex="1" parent="1"><mxGeometry x="180.0" y="1376" width="360" height="72" as="geometry"/></mxCell>
        <mxCell id="c40" value="" style="endArrow=none;html=1;strokeWidth=1.6;strokeColor=#8aa0b8;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="1412.0" as="sourcePoint"/><mxPoint x="342" y="1412.0" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c41" value="" style="endArrow=none;html=1;strokeWidth=4;strokeColor=#1e3a5f;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="774" as="sourcePoint"/><mxPoint x="836" y="188" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c42" value="邮箱验证（可后补）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;fontStyle=1;fontColor=#ffffff;strokeColor=none;arcSize=12;fillColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="680.0" y="148" width="360" height="40" as="geometry"/></mxCell>
        <mxCell id="c43" value="&lt;b&gt;1 两种补法&lt;/b&gt;&lt;br&gt;注册时填写，或登录后到「我的 → 邮箱通知」&lt;br&gt;点「发送验证邮件」。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;spacingLeft=10;spacingRight=8;spacingTop=4;spacingBottom=4;strokeWidth=1.5;arcSize=8;fillColor=#e8eefc;strokeColor=#1d4ed8;fontColor=#152033;" vertex="1" parent="1"><mxGeometry x="680.0" y="200" width="360" height="72" as="geometry"/></mxCell>
        <mxCell id="c44" value="" style="endArrow=none;html=1;strokeWidth=1.6;strokeColor=#8aa0b8;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="236.0" as="sourcePoint"/><mxPoint x="842" y="236.0" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c45" value="&lt;b&gt;2 打开邮件里的链接&lt;/b&gt;&lt;br&gt;链接 24 小时有效，指向 API 源站，&lt;br&gt;不是网页域名。点开才能完成绑定。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;spacingLeft=10;spacingRight=8;spacingTop=4;spacingBottom=4;strokeWidth=1.5;arcSize=8;fillColor=#e8eefc;strokeColor=#1d4ed8;fontColor=#152033;" vertex="1" parent="1"><mxGeometry x="680.0" y="282" width="360" height="72" as="geometry"/></mxCell>
        <mxCell id="c46" value="" style="endArrow=none;html=1;strokeWidth=1.6;strokeColor=#8aa0b8;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="318.0" as="sourcePoint"/><mxPoint x="842" y="318.0" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c47" value="&lt;b&gt;3 验证成功&lt;/b&gt;&lt;br&gt;才算邮箱已绑定。之后可按开关&lt;br&gt;接收评论等消息通知。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;spacingLeft=10;spacingRight=8;spacingTop=4;spacingBottom=4;strokeWidth=1.5;arcSize=8;fillColor=#d9f0e7;strokeColor=#0f6b52;fontColor=#134e3a;" vertex="1" parent="1"><mxGeometry x="680.0" y="364" width="360" height="72" as="geometry"/></mxCell>
        <mxCell id="c48" value="" style="endArrow=none;html=1;strokeWidth=1.6;strokeColor=#8aa0b8;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="400.0" as="sourcePoint"/><mxPoint x="842" y="400.0" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c49" value="&lt;b&gt;没收到信 / 链接失效&lt;/b&gt;&lt;br&gt;先看垃圾邮件，再在「我的」重发。&lt;br&gt;学校发信异常时，账号照样能审核、能登录。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;spacingLeft=10;spacingRight=8;spacingTop=4;spacingBottom=4;strokeWidth=1.5;arcSize=8;fillColor=#fde8e8;strokeColor=#b4232c;fontColor=#7f1d1d;" vertex="1" parent="1"><mxGeometry x="680.0" y="446" width="360" height="72" as="geometry"/></mxCell>
        <mxCell id="c50" value="" style="endArrow=none;html=1;strokeWidth=1.6;strokeColor=#8aa0b8;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="482.0" as="sourcePoint"/><mxPoint x="842" y="482.0" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c51" value="" style="endArrow=none;html=1;strokeWidth=4;strokeColor=#1e3a5f;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="806" as="sourcePoint"/><mxPoint x="836" y="1460" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c52" value="审核开通" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;fontStyle=1;fontColor=#ffffff;strokeColor=none;arcSize=12;fillColor=#a16207;" vertex="1" parent="1"><mxGeometry x="680.0" y="1460" width="360" height="40" as="geometry"/></mxCell>
        <mxCell id="c53" value="&lt;b&gt;1 审核员在后台处理&lt;/b&gt;&lt;br&gt;管理后台 →「用户与权限」。&lt;br&gt;学生不要去点「管理员入口」。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;spacingLeft=10;spacingRight=8;spacingTop=4;spacingBottom=4;strokeWidth=1.5;arcSize=8;fillColor=#f8ead2;strokeColor=#a16207;fontColor=#152033;" vertex="1" parent="1"><mxGeometry x="680.0" y="1130" width="360" height="72" as="geometry"/></mxCell>
        <mxCell id="c54" value="" style="endArrow=none;html=1;strokeWidth=1.6;strokeColor=#8aa0b8;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="1166.0" as="sourcePoint"/><mxPoint x="842" y="1166.0" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c55" value="&lt;b&gt;2 通过 → 账号可用&lt;/b&gt;&lt;br&gt;状态变为启用。同学再用同一组&lt;br&gt;用户名和密码，就可以登录。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;spacingLeft=10;spacingRight=8;spacingTop=4;spacingBottom=4;strokeWidth=1.5;arcSize=8;fillColor=#d9f0e7;strokeColor=#0f6b52;fontColor=#134e3a;" vertex="1" parent="1"><mxGeometry x="680.0" y="1212" width="360" height="72" as="geometry"/></mxCell>
        <mxCell id="c56" value="" style="endArrow=none;html=1;strokeWidth=1.6;strokeColor=#8aa0b8;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="1248.0" as="sourcePoint"/><mxPoint x="842" y="1248.0" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c57" value="&lt;b&gt;3 拒绝 → 该用户名作废&lt;/b&gt;&lt;br&gt;账号停用，不能再用来登录。&lt;br&gt;需要的话只能换一个用户名重新注册。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;spacingLeft=10;spacingRight=8;spacingTop=4;spacingBottom=4;strokeWidth=1.5;arcSize=8;fillColor=#fde8e8;strokeColor=#b4232c;fontColor=#7f1d1d;" vertex="1" parent="1"><mxGeometry x="680.0" y="1294" width="360" height="72" as="geometry"/></mxCell>
        <mxCell id="c58" value="" style="endArrow=none;html=1;strokeWidth=1.6;strokeColor=#8aa0b8;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="1330.0" as="sourcePoint"/><mxPoint x="842" y="1330.0" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c59" value="&lt;b&gt;通过前试登录&lt;/b&gt;&lt;br&gt;即使用对了密码，也只会提示&lt;br&gt;「账号正在审核，通过后才能登录」。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;spacingLeft=10;spacingRight=8;spacingTop=4;spacingBottom=4;strokeWidth=1.5;arcSize=8;fillColor=#fde8e8;strokeColor=#b4232c;fontColor=#7f1d1d;" vertex="1" parent="1"><mxGeometry x="680.0" y="1376" width="360" height="72" as="geometry"/></mxCell>
        <mxCell id="c60" value="" style="endArrow=none;html=1;strokeWidth=1.6;strokeColor=#8aa0b8;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="1412.0" as="sourcePoint"/><mxPoint x="842" y="1412.0" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c61" value="" style="endArrow=none;html=1;strokeWidth=4;strokeColor=#1e3a5f;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1360" y="774" as="sourcePoint"/><mxPoint x="1336" y="188" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c62" value="已登录后连接飞书" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;fontStyle=1;fontColor=#ffffff;strokeColor=none;arcSize=12;fillColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="1180.0" y="148" width="360" height="40" as="geometry"/></mxCell>
        <mxCell id="c63" value="&lt;b&gt;1 密码账号打开「我的」&lt;/b&gt;&lt;br&gt;点「连接飞书账户」，再走一遍飞书授权。&lt;br&gt;把当前校园墙账号挂上自己的飞书号。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;spacingLeft=10;spacingRight=8;spacingTop=4;spacingBottom=4;strokeWidth=1.5;arcSize=8;fillColor=#e8eefc;strokeColor=#1d4ed8;fontColor=#152033;" vertex="1" parent="1"><mxGeometry x="1180.0" y="200" width="360" height="72" as="geometry"/></mxCell>
        <mxCell id="c64" value="" style="endArrow=none;html=1;strokeWidth=1.6;strokeColor=#8aa0b8;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1360" y="236.0" as="sourcePoint"/><mxPoint x="1342" y="236.0" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c65" value="&lt;b&gt;2 绑定成功之后&lt;/b&gt;&lt;br&gt;以后也可以改用飞书登录这个账号。&lt;br&gt;系统会尝试把你拉进学生登录群。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;spacingLeft=10;spacingRight=8;spacingTop=4;spacingBottom=4;strokeWidth=1.5;arcSize=8;fillColor=#d9f0e7;strokeColor=#0f6b52;fontColor=#134e3a;" vertex="1" parent="1"><mxGeometry x="1180.0" y="282" width="360" height="72" as="geometry"/></mxCell>
        <mxCell id="c66" value="" style="endArrow=none;html=1;strokeWidth=1.6;strokeColor=#8aa0b8;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1360" y="318.0" as="sourcePoint"/><mxPoint x="1342" y="318.0" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c67" value="&lt;b&gt;不能假装成功&lt;/b&gt;&lt;br&gt;该飞书号已绑别人 → 拒绝合并。&lt;br&gt;进群失败时账号可能已绑定，需联系管理员。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;spacingLeft=10;spacingRight=8;spacingTop=4;spacingBottom=4;strokeWidth=1.5;arcSize=8;fillColor=#fde8e8;strokeColor=#b4232c;fontColor=#7f1d1d;" vertex="1" parent="1"><mxGeometry x="1180.0" y="364" width="360" height="72" as="geometry"/></mxCell>
        <mxCell id="c68" value="" style="endArrow=none;html=1;strokeWidth=1.6;strokeColor=#8aa0b8;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1360" y="400.0" as="sourcePoint"/><mxPoint x="1342" y="400.0" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c69" value="&lt;b&gt;两个群不要混&lt;/b&gt;&lt;br&gt;学生登录只校验学生群。&lt;br&gt;审核提醒在管理员审核群，学生不用加。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;spacingLeft=10;spacingRight=8;spacingTop=4;spacingBottom=4;strokeWidth=1.5;arcSize=8;fillColor=#f4f6f9;strokeColor=#94a3b8;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="1180.0" y="446" width="360" height="72" as="geometry"/></mxCell>
        <mxCell id="c70" value="" style="endArrow=none;html=1;strokeWidth=1.6;strokeColor=#8aa0b8;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1360" y="482.0" as="sourcePoint"/><mxPoint x="1342" y="482.0" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c71" value="" style="endArrow=none;html=1;strokeWidth=4;strokeColor=#1e3a5f;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1360" y="806" as="sourcePoint"/><mxPoint x="1336" y="1460" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c72" value="用户名密码登录" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;fontStyle=1;fontColor=#ffffff;strokeColor=none;arcSize=12;fillColor=#a16207;" vertex="1" parent="1"><mxGeometry x="1180.0" y="1460" width="360" height="40" as="geometry"/></mxCell>
        <mxCell id="c73" value="&lt;b&gt;1 留在「登录」选项卡&lt;/b&gt;&lt;br&gt;输入注册时的用户名和密码，&lt;br&gt;点「用户名密码登录」。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;spacingLeft=10;spacingRight=8;spacingTop=4;spacingBottom=4;strokeWidth=1.5;arcSize=8;fillColor=#f8ead2;strokeColor=#a16207;fontColor=#152033;" vertex="1" parent="1"><mxGeometry x="1180.0" y="1130" width="360" height="72" as="geometry"/></mxCell>
        <mxCell id="c74" value="" style="endArrow=none;html=1;strokeWidth=1.6;strokeColor=#8aa0b8;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1360" y="1166.0" as="sourcePoint"/><mxPoint x="1342" y="1166.0" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c75" value="&lt;b&gt;2 必须同时满足&lt;/b&gt;&lt;br&gt;账号已审核通过，并且这个账号设过密码。&lt;br&gt;成功后进入「我的」或原先要去的页面。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;spacingLeft=10;spacingRight=8;spacingTop=4;spacingBottom=4;strokeWidth=1.5;arcSize=8;fillColor=#d9f0e7;strokeColor=#0f6b52;fontColor=#134e3a;" vertex="1" parent="1"><mxGeometry x="1180.0" y="1212" width="360" height="72" as="geometry"/></mxCell>
        <mxCell id="c76" value="" style="endArrow=none;html=1;strokeWidth=1.6;strokeColor=#8aa0b8;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1360" y="1248.0" as="sourcePoint"/><mxPoint x="1342" y="1248.0" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c77" value="&lt;b&gt;纯飞书账号走不通这一路&lt;/b&gt;&lt;br&gt;飞书登录创建的账号没有密码，&lt;br&gt;请继续用「使用飞书登录」。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;spacingLeft=10;spacingRight=8;spacingTop=4;spacingBottom=4;strokeWidth=1.5;arcSize=8;fillColor=#fde8e8;strokeColor=#b4232c;fontColor=#7f1d1d;" vertex="1" parent="1"><mxGeometry x="1180.0" y="1294" width="360" height="72" as="geometry"/></mxCell>
        <mxCell id="c78" value="" style="endArrow=none;html=1;strokeWidth=1.6;strokeColor=#8aa0b8;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1360" y="1330.0" as="sourcePoint"/><mxPoint x="1342" y="1330.0" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c79" value="&lt;b&gt;登录之后能做什么&lt;/b&gt;&lt;br&gt;未登录可浏览失物招领列表；&lt;br&gt;填写启事、发帖、评论、点赞需要登录。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;spacingLeft=10;spacingRight=8;spacingTop=4;spacingBottom=4;strokeWidth=1.5;arcSize=8;fillColor=#f4f6f9;strokeColor=#94a3b8;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="1180.0" y="1376" width="360" height="72" as="geometry"/></mxCell>
        <mxCell id="c80" value="" style="endArrow=none;html=1;strokeWidth=1.6;strokeColor=#8aa0b8;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1360" y="1412.0" as="sourcePoint"/><mxPoint x="1342" y="1412.0" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c81" value="&lt;b&gt;边界（画在鱼骨外，避免和学生主路径混在一起）&lt;/b&gt;&lt;br&gt;①「管理员入口」是后台登录，学生不要用；后台账号只能由超级管理员创建，前台注册成不了管理员。&lt;br&gt;② 飞书登录、用户名注册都只产生普通用户。审核员 / 管理员另有账号，且飞书登录不授予后台权限。&lt;br&gt;③ 网站不展示加群二维码。进学生群按学校飞书工作安排。审核群自定义机器人只发审核提醒，不能拿来登录。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#5b6678;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1518" width="1880" height="120" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
